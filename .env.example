# Required for live interpretation.
OPENAI_API_KEY=

# Translation engine. Default is the dedicated low-latency translation model.
# Use "prompted" only when you specifically need glossary/custom terminology instructions.
OPENAI_TRANSLATION_MODE=translate
OPENAI_REALTIME_MODEL=gpt-realtime-translate
OPENAI_PROMPTED_REALTIME_MODEL=gpt-realtime-2.1

# App settings.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
HOST_RECONNECT_GRACE_MS=30000
ROOM_RETENTION_MS=3600000
